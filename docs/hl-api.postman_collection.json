{
  "info": {
    "_postman_id": "hl-api-0000-0000-0000-000000000001",
    "name": "hl-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Test collection for the hl-api service.\n\nSet the `baseUrl` variable (default http://localhost:8080). For the Account folder, paste a Privy access token into `privyToken`.\n\nWhat works when:\n- Ops (healthz/readyz/metrics): always.\n- Earnings + Assets: once Supabase creds are set and the tables are seeded.\n- Account (signup/session/profile/portfolio/positions): once Privy is wired. Portfolio additionally needs PRIVY_APP_SECRET for wallet resolution."
  },
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "200 {\"status\":\"ok\"} if the process is up."
          }
        },
        {
          "name": "Readiness (checks Supabase)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "200 when Supabase is reachable; reports auth-bridge state."
          }
        },
        {
          "name": "Metrics (Prometheus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Prometheus exposition format."
          }
        }
      ]
    },
    {
      "name": "Assets (public)",
      "item": [
        {
          "name": "Earnings calendar (upcoming)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/earnings?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "earnings"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "from",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "dex",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Upcoming earnings calendar, shaped 1:1 to the app's MarketEvent. Supabase-only; no price data."
          }
        },
        {
          "name": "Assets list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/assets?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "dex",
                  "value": "xyz",
                  "disabled": true
                }
              ]
            },
            "description": "Paginated asset catalog."
          }
        },
        {
          "name": "Asset detail (the asset page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/assets/{{ticker}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assets",
                "{{ticker}}"
              ]
            },
            "description": "Aggregated asset page: metadata + next earnings + expected EPS + beat odds + past earnings + mark price. 404 until the assets/earnings tables are seeded."
          }
        }
      ]
    },
    {
      "name": "Account (auth — Privy bearer)",
      "item": [
        {
          "name": "Auth session (mint Supabase JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const t = pm.response.json().supabaseAccessToken;",
                  "  if (t) { pm.collectionVariables.set('supabaseToken', t); console.log('captured supabaseToken'); }",
                  "} else {",
                  "  console.log('auth not available:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{privyToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "session"
              ]
            },
            "description": "Verify the Privy token, mint a Supabase session JWT. On 200, the test script stores it in `supabaseToken`. 503 auth_not_configured until Privy env is set."
          }
        },
        {
          "name": "Profile (identity + lazy create)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{privyToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "profile"
              ]
            },
            "description": "Verified id + wallet; lazily upserts the profile row. 503 until Privy wired; 401 without a token."
          }
        },
        {
          "name": "Portfolio (account value + positions)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{privyToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "portfolio"
              ]
            },
            "description": "Live HL account value/cash/positions + 24h change. Needs Privy + HL_PROXY_KEY + a wallet on the profile."
          }
        },
        {
          "name": "Positions closed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{privyToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/positions/closed?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "positions",
                "closed"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            },
            "description": "Closed positions (realized PnL, open/close time) from HL fills. days max 90."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "coin",
      "value": "AAPL"
    },
    {
      "key": "ticker",
      "value": "AAPL"
    },
    {
      "key": "privyToken",
      "value": ""
    },
    {
      "key": "supabaseToken",
      "value": ""
    },
    {
      "key": "from",
      "value": ""
    },
    {
      "key": "to",
      "value": ""
    }
  ]
}