# dependencies
node_modules/

# build output
dist/

# env / secrets — never commit
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/

# local scratch
tmp/
tmp-*.ts

# local agent tooling (Claude Code / skill bundles) — keep out of the app repo
.claude/
.agents/
skills-lock.json
.mcp.json

# Supabase: migrations are tracked (they are the record of a schema managed
# through the MCP/dashboard); the CLI's local working state is not.
supabase/.temp/
supabase/.branches/

# Postman VS Code extension working state. It mirrors
# docs/hl-api.postman_collection.json into a cloud-synced directory copy, so
# committing it would version the same collection twice and pin a workspace id.
# If the directory format ever becomes the source of truth, un-ignore these and
# delete the single-file JSON instead.
docs/.postman/
docs/postman/
