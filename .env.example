# Copy this file to .env and fill in values for your environment.
# .env is gitignored; .env.example is committed as a template.
# Existing shell env vars take precedence over .env values.

# --- Service ---
PORT=8080
LOG_LEVEL=info          # one of: trace, debug, info, warn, error, fatal
NODE_ENV=development    # development | production

# --- Hyperliquid ---
# Reads go straight to https://api.hyperliquid.xyz/info (public, no key, no proxy).
# HL_DEX is the HIP-3 builder dex the app trades; blank means the default perp dex.
HL_DEX=xyz

# --- Supabase (server-side; service role bypasses RLS) ---
# Leave blank to run the public read tier only; the auth bridge stays dormant
# (auth routes return 503 auth_not_configured) until these are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Earnings schedule: Alpha Vantage (dates, pre/post-market, EPS) ---
# Free key: https://www.alphavantage.co/support/#api-key (25 requests/day,
# personal use; a commercial licence is needed before public launch).
ALPHAVANTAGE_API_KEY=
# --- SEC EDGAR (exact release times; free, no key) ---
# SEC asks for a descriptive User-Agent with a contact email.
SEC_USER_AGENT=

# --- APNs (push notifications) ---
# Dormant until all three secrets are set; the service runs fine without them
# and notifications still land in the server-side inbox.
# From Apple Developer -> Certificates, Identifiers & Profiles -> Keys.
# APNS_KEY is the .p8 file's CONTENTS (a PKCS#8 PEM). Newlines may be escaped.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# The APNs topic. Matches PRODUCT_BUNDLE_IDENTIFIER in the Xcode project.
APNS_BUNDLE_ID=buzz.Earnings

# --- Takes (position-gated posts) ---
# How long after a trade a user may post about it. Short by design: the post is
# evidence the trade just happened, so a long window weakens the signal.
# Product question Q1 in tmp/systems-design/chat-and-takes.md is still open —
# 600s is a placeholder, not a decision.
TAKE_WINDOW_SECONDS=600
TAKE_MAX_LENGTH=500

# --- Privy (auth provider) ---
# APP_ID + VERIFICATION_KEY enable sign-in: access tokens are verified OFFLINE
# against the public verification key (Privy Dashboard -> App settings -> JWT
# verification key). No network call, no secret needed.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# APP_SECRET is needed ONLY to resolve a user's embedded wallet address, which
# requires calling Privy's API (getUser). The access token does not carry the
# wallet. Without this, sign-in still works but profiles have no wallet_address,
# and anything keyed on the wallet (positions, fee attribution) stays dormant.
# Privy Dashboard -> App settings -> App secret (shown once at app creation).
PRIVY_APP_SECRET=
